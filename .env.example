# Backend / workers
DATABASE_URL=postgresql+psycopg://guad:guad@localhost:5432/guad
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=guad-enterprises
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret

# Public data imports
SIRENE_API_BASE=https://api.insee.fr/api-sirene/3.11
SIRENE_API_TOKEN=
BAN_API_BASE=https://api-adresse.data.gouv.fr
NOMINATIM_BASE_URL=
IMPORT_DEPARTMENT_CODES=971

# Security
AUTH_SECRET=
ADMIN_ACCESS_TOKEN=
ADMIN_SESSION_SECRET=
ADMIN_ROLE=SUPER_ADMIN
PROSPECTS_CRM_DB_PATH=
# Secret local de 32 caractères ou plus ; à définir dans l'environnement, jamais dans Git.
CARAAIOS_MCP_TOKEN=
CARAAIOS_MCP_PORT=3100
WORKSPACE_RETENTION_DAYS=180
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
BI_CACHE_TTL_SECONDS=300

# Optional recruitment enrichment (France Travail API; off by default)
FRANCE_TRAVAIL_RECRUITMENT_LIVE=false
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
FRANCE_TRAVAIL_OFFERS_API=https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search
